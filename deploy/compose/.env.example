# Copy to .env and adjust if needed. Dev-only defaults; never use in production.

# 32-byte key, base64 (generate: openssl rand -base64 32)
# Dev-only 32-byte key (tests use the same pattern). Replace for non-local use:
#   openssl rand -base64 32
AS_AUDIT_RESOURCE_HMAC_KEY_B64=a2tra2tra2tra2tra2tra2tra2tra2tra2tra2tra2s=

POSTGRES_SUPERUSER_PASSWORD=postgres
AS_CONFIG_OWNER_PASSWORD=as_config_owner_dev
AS_CONFIG_WEB_PASSWORD=as_config_web_dev

# Fixed subnet for Caddy → config-service trusted proxy headers (see compose.yml networks).
AS_CONFIG_TRUSTED_PROXIES=10.89.0.0/24

HTTPS_PUBLISH_PORT=8443
POSTGRES_PUBLISH_PORT=55432

# Used by scripts/smoke-https.sh
AS_COMPOSE_HTTPS_URL=https://localhost:8443

# Testbed health stub (optional fleet inventory registration)
AS_TESTBED_HEALTH_URL=http://10.89.0.30:8080/health
