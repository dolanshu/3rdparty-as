# 3rdparty-as 环境变量模板 —— 值为占位符，各进程启动时读取
# 按架构文档已确认的进程边界组织（参考 AGENT.md §13、ADR-0006/0016）

# === SIP 信令面（所有 apps/ 进程） ===
# 监听地址（绑定本机某 IP 或 0.0.0.0）
SIP_LISTEN_ADDR=0.0.0.0
# 监听端口（每实例唯一；多副本需各实例分配不同端口）
SIP_LISTEN_PORT=5060
# 对端白名单（逗号分隔 IP/网段；仅接受来自 S-SBC 的 INVITE）
SIP_PEER_ALLOWLIST=
# TLS 是否启用（ADR-0016 端到端 TLS）
SIP_TLS_ENABLED=false
# TLS 证书路径（轮换由热更机制处理，不重启进程）
SIP_TLS_CERT_PATH=
SIP_TLS_KEY_PATH=

# === 状态存储（Redis + Sentinel，ADR-0002/0007） ===
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_MASTER_NAME=
REDIS_PASSWORD=

# === 配置治理（PostgreSQL，ADR-0006/0007） ===
CONFIG_DB_URL=postgresql://user:pass@host:5432/config

# === 观测性（OTel，ADR-0005） ===
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=3rdparty-as

# === 进程通用 ===
# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO
# 当前加载的规则版本（config-service 灰度分发后注入；进程启动时读取）
CONFIG_VERSION=
